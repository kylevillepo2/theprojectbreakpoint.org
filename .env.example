# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (used by /api/contact and /api/subscribe)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name for /api/contact (defaults to projectbreakpoint).
# Note: /api/subscribe always uses "projectbreakpoint".
MONGODB_DB=projectbreakpoint
